// -----------------------------------------------------
// Prisma Schema — SQLite
// Stages: raw, processed, sorted (append-only: ledger + transport)
// -----------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// -------------------- Enums --------------------------

enum Size {
  LUMPS
  CHIPS
  FINE
  ANY          // unify 3s/4s: raw uses ANY
}

enum Shade {
  WHITE
  GREY
  LIGHTGREY
  GREEN
  MIXED
}


enum LedgerReason {
  DIRECT
  PROCESS
  TRANSPORT
  REVERSAL
  ADJUST
}

enum TransportEventType {
  DISPATCH
  RECEIVE
  CANCEL
}

// -------------------- Reference ----------------------

model Supplier {
  id    Int    @id @default(autoincrement())
  name  String
  code  String @unique

  // processed back-relations
  processedLedgerRows    ProcessedLedger[]    @relation("SupplierToProcessedLedger")
  processedTransportRows ProcessedTransport[] @relation("SupplierToProcessedTransport")

  // raw back-relations
  rawLedgerRows          RawLedger[]          @relation("SupplierToRawLedger")
  rawTransportRows       RawTransport[]       @relation("SupplierToRawTransport")

  // sorted back-relations
  sortedLedgerRows       SortedLedger[]       @relation("SupplierToSortedLedger")
  sortedTransportRows    SortedTransport[]    @relation("SupplierToSortedTransport")
}

// -------------------- processed (stage) ---------------

model ProcessedLedger {
  id           Int          @id @default(autoincrement())
  createdAt    DateTime     @default(now())

  mmaCode      String?
  stationCode  String?

  supplierId   Int
  supplier     Supplier     @relation("SupplierToProcessedLedger", fields: [supplierId], references: [id])

  shade        Shade
  size         Size

  qtyDelta     Float
  reason       LedgerReason
  linkId       String?
  meta         Json?

  @@index([mmaCode, createdAt])
  @@index([mmaCode, supplierId, shade, size])
  @@index([linkId])
  @@map("processed_ledger")
}

model ProcessedTransport {
  id               Int                 @id @default(autoincrement())
  createdAt        DateTime            @default(now())

  transportId      String
  type             TransportEventType

  fromMmaCode      String?
  toMmaCode        String?
  fromStationCode  String?
  toStationCode    String?

  supplierId       Int
  supplier         Supplier            @relation("SupplierToProcessedTransport", fields: [supplierId], references: [id])

  shade            Shade
  size             Size

  qty              Float
  amount           Int?
  meta             Json?

  @@unique([transportId, type])
  @@index([transportId])
  @@index([fromMmaCode, createdAt])
  @@index([toMmaCode, createdAt])
  @@map("processed_transport")
}

// -------------------- raw (stage) ---------------------

model RawLedger {
  id           Int          @id @default(autoincrement())
  createdAt    DateTime     @default(now())

  mmaCode      String
  stationCode  String?

  supplierId   Int
  supplier     Supplier     @relation("SupplierToRawLedger", fields: [supplierId], references: [id])

  shade        Shade
  size         Size         // will be ANY for raw

  qtyDelta     Float
  reason       LedgerReason
  linkId       String?
  meta         Json?

  @@index([mmaCode, createdAt])
  @@index([mmaCode, supplierId, shade, size])
  @@index([linkId])
  @@map("raw_ledger")
}

model RawTransport {
  id               Int                 @id @default(autoincrement())
  createdAt        DateTime            @default(now())

  transportId      String
  type             TransportEventType

  fromMmaCode      String?
  toMmaCode        String?
  fromStationCode  String?
  toStationCode    String?

  supplierId       Int
  supplier         Supplier            @relation("SupplierToRawTransport", fields: [supplierId], references: [id])

  shade            Shade
  size             Size                // ANY for raw

  qty              Float
  amount           Int?
  meta             Json?

  @@unique([transportId, type])
  @@index([transportId])
  @@index([fromMmaCode, createdAt])
  @@index([toMmaCode, createdAt])
  @@map("raw_transport")
}

// -------------------- sorted (stage) ------------------

model SortedLedger {
  id           Int          @id @default(autoincrement())
  createdAt    DateTime     @default(now())

  mmaCode      String
  stationCode  String?

  supplierId   Int
  supplier     Supplier     @relation("SupplierToSortedLedger", fields: [supplierId], references: [id])

  shade        Shade
  size         Size

  qtyDelta     Float
  reason       LedgerReason
  linkId       String?
  meta         Json?

  @@index([mmaCode, createdAt])
  @@index([mmaCode, supplierId, shade, size])
  @@index([linkId])
  @@map("sorted_ledger")
}

model SortedTransport {
  id               Int                 @id @default(autoincrement())
  createdAt        DateTime            @default(now())

  transportId      String
  type             TransportEventType

  fromMmaCode      String?
  toMmaCode        String?
  fromStationCode  String?
  toStationCode    String?

  supplierId       Int
  supplier         Supplier            @relation("SupplierToSortedTransport", fields: [supplierId], references: [id])

  shade            Shade
  size             Size

  qty              Float
  amount           Int?
  meta             Json?

  @@unique([transportId, type])
  @@index([transportId])
  @@index([fromMmaCode, createdAt])
  @@index([toMmaCode, createdAt])
  @@map("sorted_transport")
}
model process_tbl {
  id               Int       @id @default(autoincrement())
  createdAt        DateTime  @default(now())
  // identity
  processId        String    @unique     // same id linked in Stock.withdraw/deposit linkId
  processType      String                 // "PROCESSING" (room to add others later)
  // bridge RAW -> PROCESSED
  fromMmaCode      String                  // e.g., "ABS_RAW"
  toMmaCode        String                  // e.g., "ABS_PROCESSED"
  supplierId       Int
  fromStationCode  String?
  toStationCode    String?
  // source (one RAW slot)
  sourceShade      String
  sourceSize       String                  // "ANY" allowed; use tons only
  sourceQtyT       Decimal                 // tons consumed
  // targets (many PROCESSED slots)
  targetsQtyT      Decimal                 // Σ of target tons
  targets          Json                    // [{ shade, size, qtyT }, ...]
  // status
  status           String                  // "SUCCESS" | "ROLLED_BACK" | "FAILED"
  error            String?                 // captured error message when not SUCCESS
  meta             Json?
  @@index([fromMmaCode, toMmaCode, supplierId])
}
model sorting_tbl {
  id               Int       @id @default(autoincrement())
  createdAt        DateTime  @default(now())
  committedAt      DateTime?

  // idempotency / identity
  processId        String    @unique
  processType      String?   // "SORTING" (optional, for readability)

  // strict pair: PROCESSED -> SORTED
  fromMmaCode      String      // e.g., "ABS_PROCESSED"
  toMmaCode        String      // e.g., "ABS_SORTED"
  supplierId       Int
  fromStationCode  String?
  toStationCode    String?

  // source (PROCESSED)
  fromShade        String
  fromSize         String
  // destination (SORTED)
  toShade          String
  toSize           String

  // quantity (tons) — identical both sides
  qtyT             Decimal

  // NEW: top-level attributes for this process
  ht               Int?        // e.g., 55
  wastage          Decimal?    // percent (0..100). External funcs can map/interpret.

  // ledger linkage (for audit)
  withdrawLedgerId String
  depositLedgerId  String

  // outcome
  status           String      // "SUCCESS" | "ROLLED_BACK" | "FAILED"
  error            String?
  // keep meta for any extras beyond ht/wastage
  meta             Json?

  @@index([fromMmaCode, toMmaCode, supplierId])
  @@index([createdAt])
}
