// -----------------------------------------------------
// Prisma Schema — SQLite
// Stage tables: rawMaterial3s, processed4s, sorted4s
// Global logs: Transport, Process
// -----------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// -------------------- Enums --------------------------

enum BornAs {
  DEPOSIT
  TRANSFER
  PROCESS
}

enum EdgeStatus {
  IN_TRANSIT
  RECEIVED
  CANCELED
}

enum Size {
  LUMPS
  CHIPS
  FINE
}

enum Shade {
  WHITE
  GREY
  LIGHTGREY
  GREEN
  MIXED
}

enum MmaCode {
  ABS_RAW
  ABS_PROCESSED
  PSS_PROCESSED
  PSS_SORTED
}



enum ProcessType {
  SCREENING
  SORTING
  BLENDING
  OTHER
}

// -------------------- Reference ----------------------

model Supplier {
  id   Int    @id @default(autoincrement())
  name String
  code String @unique

  rawRows       rawMaterial3s[]
  processedRows processed4s[]
  sortedRows    sorted4s[]
}
// -------------------- New Enums ----------------------

enum LedgerReason {
  DIRECT
  PROCESS
  TRANSPORT
  REVERSAL
  ADJUST
}

enum TransportEventType {
  DISPATCH
  RECEIVE
  CANCEL
}

// -------------------- processed (stage) ---------------
// Append-only postings that drive on-hand math
model ProcessedLedger {
  id           Int          @id @default(autoincrement())
  createdAt    DateTime     @default(now())

  mmaCode      MmaCode
  stationCode  String?      // optional pass-through (UI/logs)
  supplierId   Int
  supplier     Supplier     @relation(fields: [supplierId], references: [id])

  shade        Shade
  size         Size

  qtyDelta     Float        // +qty or -qty
  reason       LedgerReason // DIRECT | PROCESS | TRANSPORT | REVERSAL | ADJUST
  linkId       String?      // transportId or processId (for lineage)
  meta         Json?

  @@index([mmaCode, supplierId, shade, size])
  @@index([linkId])
  @@map("processed_ledger")
}

// Append-only transport events; compare DISPATCH vs RECEIVE by transportId
model ProcessedTransport {
  id              Int                 @id @default(autoincrement())
  createdAt       DateTime            @default(now())

  transportId     String
  type            TransportEventType  // DISPATCH | RECEIVE | CANCEL

  fromMmaCode     MmaCode?
  toMmaCode       MmaCode?
  fromStationCode String?
  toStationCode   String?

  supplierId      Int
  supplier        Supplier            @relation(fields: [supplierId], references: [id])

  shade           Shade
  size            Size

  qty             Float
  amount          Int?                // money (e.g., cents)
  meta            Json?

  @@unique([transportId, type])       // prevents double RECEIVE/CANCEL
  @@index([fromMmaCode])
  @@index([toMmaCode])
  @@index([createdAt])
  @@map("processed_transport")
}
