// -----------------------------------------------------
// Prisma Schema — SQLite (UNIFIED)
// Stages captured via `Family` enum in ONE pair of tables
// -----------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// -------------------- Enums --------------------------

// enum Family {
//   RAW
//   SCREENED
//   SORTED
//   PRODUCTION
// }

enum Size {
  LUMPS
  CHIPS
  FINE
  ANY          // unify 3s/4s: raw uses ANY
}

enum Shade {
  WHITE
  GREY
  LIGHTGREY
  GREEN
  MIXED
}

enum LedgerReason {
  PROCESS
  TRANSPORT
  REVERSAL
  ADJUST
  PURCHASE 
}

enum TransportEventType {
  DISPATCH
  RECEIVE
  CANCEL
}

// -------------------- Reference ----------------------

model Supplier {
  id    Int    @id @default(autoincrement())
  name  String
  code  String @unique

  // unified back-relations
  stockLedgerRows    StockLedger[]    @relation("SupplierToStockLedger")
  stockTransportRows StockTransport[] @relation("SupplierToStockTransport")

  purchases          purchase_tbl[]   @relation("SupplierToPurchase")
}

// -------------------- UNIFIED STOCK TABLES ------------

model StockLedger {
  id           Int          @id @default(autoincrement())
  createdAt    DateTime     @default(now())

  mmaCode      String

  supplierId   Int
  supplier     Supplier     @relation("SupplierToStockLedger", fields: [supplierId], references: [id])

  shade        Shade
  size         Size

  qtyDelta     Float
  reason       LedgerReason
  linkId       String?      // processId or transportId (for audit chains)
  meta         Json?

 purchaseDeposits purchase_tbl[] @relation("PurchaseDeposit")
  @@index([mmaCode, createdAt])
  @@index([mmaCode, supplierId, shade, size])
  @@index([supplierId, shade, size])
  @@index([linkId])
  @@map("stock_ledger")
}

model StockTransport {
  id               Int                 @id @default(autoincrement())
  createdAt        DateTime            @default(now())

  transportId      String
  type             TransportEventType

  fromMmaCode      String?
  toMmaCode        String?

  supplierId       Int
  supplier         Supplier            @relation("SupplierToStockTransport", fields: [supplierId], references: [id])

  shade            Shade
  size             Size

  qty              Float
  amount           Int?
  meta             Json?

  @@unique([transportId, type])
  @@index([transportId])
  @@index([fromMmaCode, createdAt])
  @@index([toMmaCode, createdAt])
  @@index([supplierId, shade, size])
  @@map("stock_transport")
}

// 2) purchase table (unscreened RAW → deposit only)
model purchase_tbl {
  id              String    @id @default(cuid())
  createdAt       DateTime  @default(now())
  docDate         DateTime

  supplierId Int
  supplier   Supplier @relation("SupplierToPurchase", fields: [supplierId], references: [id])

  toMmaCode       String    // e.g., "ABS_RAW"
  shade           Shade
  size            Size      @default(ANY) // RAW = ANY

  // quantity breakdown (tons)
  quantity        Float

  // commercials
  paymentMode     String?
  ratePerMt       Float?
  freightPerMt    Float?
  supplierFreight Float?
  roadExp         Float?
  cashPaid        Float?
  remarks         String?
  meta            Json?

  // hard FK to the ledger row that booked this deposit (+qty)
  depositLedgerId Int       @unique
  depositLedger   StockLedger @relation("PurchaseDeposit", fields: [depositLedgerId], references: [id])

  @@index([supplierId, docDate])
  @@index([toMmaCode, docDate])
}
// -------------------- PROCESS TABLES (aligned) --------

model sorting_tbl {
  id          Int      @id @default(autoincrement())
  createdAt   DateTime @default(now())
  committedAt DateTime?
  ht          Decimal?         // optional attribute
  wastage     Decimal?     // optional attribute
  meta        Json?

  @@index([createdAt])
}

model screening_tbl {
  id               Int       @id @default(autoincrement())
  createdAt        DateTime  @default(now())
  qtyT             Decimal
  committedAt      DateTime?
  meta             Json?
  @@index([createdAt])
}