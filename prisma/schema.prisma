// prisma/schema.prisma
// Single-ledger MMA design: only `Supplier` + `raw` (append-only).
// MMAs are code/registry values (e.g., "ABS.SLOTS", "PSS.DUMP"); no table for MMAs.
// Canonical rule: a TRANSFER is ONE row written by two methods (dispatch → receive).
// No requestId/idempotency key — lifecycle is driven by the row's primary key `id`.

// ---------- Generator & Datasource ----------
generator client {
  provider = "prisma-client-js"
}

datasource db {
  // For SQLite now; portable to Postgres/MySQL later by changing provider+URL.
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------- Enums ----------
enum BornAs {
  DEPOSIT   // born here, no transit lifecycle
  TRANSFER  // moves from A -> B (dispatch -> receive)
}

enum EdgeStatus {
  IN_TRANSIT
  RECEIVED
  CANCELED
}

enum Size {
  LUMPS
  CHIPS
  FINE
}

// ---------- Reference ----------
model Supplier {
  id    Int    @id @default(autoincrement())
  name  String
  code  String @unique   // e.g., SUP001

  // All ledger rows linked to this supplier
  raw   Raw[]
}

// ---------- Single Ledger Table ----------
model Raw {
  id            Int         @id @default(autoincrement())

  // Lifecycle & identity
  bornAs        BornAs
  status        EdgeStatus  @default(IN_TRANSIT) // deposits will be inserted as RECEIVED in services

  // Routing (MMA codes come from an app-level registry; no FK here)
  fromMmaCode   String?                           // NULL for DEPOSIT
  toMmaCode     String                            // always set

  // Lineage
  supplierId    Int
  supplier      Supplier    @relation(fields: [supplierId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  size          Size
  dispatchShade String                           // shade at source (or at deposit)
  receiveShade  String?                          // shade at destination (set on receive; defaults to dispatchShade if omitted)

  // Quantities (weights/tons etc.)
  dispatchQty   Decimal                           // planned at dispatch; for deposits equals receiveQty
  receiveQty    Decimal?                          // actual at receive; for deposits equals dispatchQty

  // Audit
  meta          Json?
  createdAt     DateTime     @default(now())
  receivedAt    DateTime?

  // Helpful indexes
  @@index([toMmaCode, status, createdAt])
  @@index([fromMmaCode, status, createdAt])
  @@index([toMmaCode, supplierId, size, status])
  @@index([fromMmaCode, supplierId, size, status])

  @@map("raw")
}

/*
---------------------------------------
Notes & Query Math (for reference only)
---------------------------------------
On-hand(M, supplierId, shade, size) =
  Σ rows where bornAs=DEPOSIT AND toMmaCode=M (receiveQty)
+ Σ rows where bornAs=TRANSFER AND toMmaCode=M AND status=RECEIVED (receiveQty)
- Σ rows where bornAs=TRANSFER AND fromMmaCode=M AND status IN (IN_TRANSIT, RECEIVED) (dispatchQty)

Semantics:
- deposit(): insert one row with bornAs=DEPOSIT, status=RECEIVED,
  fromMmaCode=NULL, toMmaCode=..., dispatchQty=receiveQty, dispatchShade=receiveShade.
- dispatch(): insert one row with bornAs=TRANSFER, status=IN_TRANSIT,
  fromMmaCode=A, toMmaCode=B, dispatchQty, dispatchShade.
- receive(id): update that row by primary key:
  status=RECEIVED, receiveQty (default to dispatchQty),
  receiveShade (default to dispatchShade), receivedAt=now().

Integrity (enforced in services):
- Non-negative pre-dispatch check using computed on-hand.
- fromMmaCode != toMmaCode for TRANSFER.
- supplierId must remain constant from dispatch to receive.
- Shade may change; both dispatchShade and receiveShade are recorded.

SQLite & Decimal:
- Prisma emulates Decimal on SQLite using strings; acceptable for weights.
  If inconvenient, switch both qty fields to Float.
*/
