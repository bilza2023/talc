// -----------------------------------------------------
// Prisma Schema — SQLite (UNIFIED)
// Stages captured via `Family` enum in ONE pair of tables
// -----------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// -------------------- Enums --------------------------

// enum Family {
//   RAW
//   SCREENED
//   SORTED
//   PRODUCTION
// }

enum Size {
  LUMPS
  CHIPS
  FINE
  ANY // unify 3s/4s: raw uses ANY
}

enum Shade {
  WHITE
  GREY
  LIGHTGREY
  GREEN
  MIXED
}

enum LedgerReason {
  DIRECT
  PROCESS
  TRANSPORT
  REVERSAL
  ADJUST
}

enum TransportEventType {
  DISPATCH
  RECEIVE
  CANCEL
}

// -------------------- Reference ----------------------

model Supplier {
  id   Int    @id @default(autoincrement())
  name String
  code String @unique

  // unified back-relations
  stockLedgerRows    StockLedger[]    @relation("SupplierToStockLedger")
  stockTransportRows StockTransport[] @relation("SupplierToStockTransport")
}

// -------------------- UNIFIED STOCK TABLES ------------

model StockLedger {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())

  mmaCode String

  supplierId Int
  supplier   Supplier @relation("SupplierToStockLedger", fields: [supplierId], references: [id])

  shade Shade
  size  Size

  qtyDelta Float
  reason   LedgerReason
  linkId   String? // processId or transportId (for audit chains)
  meta     Json?

  // back-relations for screening_tbl (named to avoid ambiguity)
  screeningWithdraws screening_tbl[] @relation("ScreeningWithdraw")
  screeningDeposits  screening_tbl[] @relation("ScreeningDeposit")

  @@index([mmaCode, createdAt])
  @@index([mmaCode, supplierId, shade, size])
  @@index([supplierId, shade, size])
  @@index([linkId])
  @@map("stock_ledger")
}

model StockTransport {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())

  transportId String
  type        TransportEventType

  fromMmaCode String?
  toMmaCode   String?

  supplierId Int
  supplier   Supplier @relation("SupplierToStockTransport", fields: [supplierId], references: [id])

  shade Shade
  size  Size

  qty    Float
  amount Int?
  meta   Json?

  @@unique([transportId, type])
  @@index([transportId])
  @@index([fromMmaCode, createdAt])
  @@index([toMmaCode, createdAt])
  @@index([supplierId, shade, size])
  @@map("stock_transport")
}

// -------------------- PROCESS TABLES (aligned) --------

model process_tbl {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())

  // identity
  processId   String @unique // may also be stored in StockLedger.linkId
  processType String // e.g., "PROCESSING"

  // bridge RAW -> SCREENED
  fromMmaCode     String
  toMmaCode       String
  supplierId      Int
  fromStationCode String?
  toStationCode   String?

  // source (one RAW slot)
  sourceShade String
  sourceSize  String // "ANY" allowed
  sourceQtyT  Decimal // tons consumed

  // targets (many SCREENED slots)
  targetsQtyT Decimal // Σ of target tons
  targets     Json // [{ shade, size, qtyT }, ...]

  // status
  status String // "SUCCESS" | "ROLLED_BACK" | "FAILED"
  error  String?
  meta   Json?

  @@index([fromMmaCode, toMmaCode, supplierId])
}

model screening_tbl {
  id          Int       @id @default(autoincrement())
  createdAt   DateTime  @default(now())
  committedAt DateTime?

  // idempotency / identity
  processId   String  @unique
  processType String? // "SORTING" (optional)

  // strict pair: SCREENED -> SORTED
  fromMmaCode     String
  toMmaCode       String
  supplierId      Int
  fromStationCode String?
  toStationCode   String?

  // source (SCREENED)
  fromShade String
  fromSize  String
  // destination (SORTED)
  toShade   String
  toSize    String

  // quantity (tons) — identical both sides
  qtyT Decimal

  // attributes for this process
  ht      Int?
  wastage Decimal?

  // ledger linkage (audit) — named relations to avoid ambiguity
  withdrawLedgerId Int
  withdrawLedger   StockLedger @relation(name: "ScreeningWithdraw", fields: [withdrawLedgerId], references: [id])

  depositLedgerId Int
  depositLedger   StockLedger @relation(name: "ScreeningDeposit", fields: [depositLedgerId], references: [id])

  // outcome
  status String // "SUCCESS" | "ROLLED_BACK" | "FAILED"
  error  String?
  meta   Json?

  @@index([fromMmaCode, toMmaCode, supplierId])
  @@index([createdAt])
}
