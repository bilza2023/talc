// -----------------------------------------------------
// Prisma Schema — SQLite
// Stage tables: rawMaterial3s, processed4s, sorted4s
// Global logs: Transport, Process
// -----------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// -------------------- Enums --------------------------

enum BornAs {
  DEPOSIT
  TRANSFER
  PROCESS
}

enum EdgeStatus {
  IN_TRANSIT
  RECEIVED
  CANCELED
}

enum Size {
  LUMPS
  CHIPS
  FINE
}

enum Shade {
  WHITE
  GREY
  LIGHTGREY
  GREEN
  MIXED
}

enum MmaCode {
  ABS_RAW
  ABS_PROCESSED
  PSS_PROCESSED
  PSS_SORTED
}

enum StageTable {
  RAW_MATERIAL_3S
  PROCESSED_4S
  SORTED_4S
}

enum ProcessType {
  SCREENING
  SORTING
  BLENDING
  OTHER
}

// -------------------- Reference ----------------------

model Supplier {
  id   Int    @id @default(autoincrement())
  name String
  code String @unique

  rawRows       rawMaterial3s[]
  processedRows processed4s[]
  sortedRows    sorted4s[]
}

// -------------------- Global Logs --------------------
// Transport: logistics within the SAME stage table
model Transport {
  id          Int        @id @default(autoincrement())
  fromTable   StageTable
  toTable     StageTable // should equal fromTable for transport (enforced in app)
  fromMmaCode MmaCode?
  toMmaCode   MmaCode
  status      EdgeStatus
  meta        Json?
  createdAt   DateTime   @default(now())
  completedAt DateTime?

  // Back-relations (named)
  processedRows processed4s[]   @relation("Transport_processed4s")
  sortedRows    sorted4s[]      @relation("Transport_sorted4s")
  rawRows       rawMaterial3s[] @relation("Transport_rawMaterial3s")

  @@index([status, createdAt])
  @@index([fromTable, fromMmaCode])
  @@index([toTable, toMmaCode])
}

// Process: transformation ACROSS tables (stage change)
model Process {
  id          Int         @id @default(autoincrement())
  type        ProcessType
  fromTable   StageTable
  toTable     StageTable // must differ from fromTable (enforced in app)
  fromMmaCode MmaCode?
  toMmaCode   MmaCode?
  meta        Json?
  createdAt   DateTime    @default(now())

  // Back-relations (named)
  processedRows processed4s[]   @relation("Process_processed4s")
  sortedRows    sorted4s[]      @relation("Process_sorted4s")
  rawRows       rawMaterial3s[] @relation("Process_rawMaterial3s")

  @@index([type, createdAt])
  @@index([fromTable, toTable])
}

// -----------------------------------------------------
// 4-slot stage (Size required) — processed4s
// -----------------------------------------------------
model processed4s {
  id     Int        @id @default(autoincrement())
  bornAs BornAs
  status EdgeStatus

  fromMmaCode MmaCode?
  toMmaCode   MmaCode

  supplierId Int
  supplier   Supplier @relation(fields: [supplierId], references: [id])

  size Size

  dispatchShade Shade
  receiveShade  Shade?

  // Quantities: use Float on SQLite to avoid Decimal quirks
  dispatchAmount Int?
  receiveAmount  Int?

  dispatchQty Float
  receiveQty  Float?

  // Optional links to headers (named relations)
  transportId Int?
  transport   Transport? @relation("Transport_processed4s", fields: [transportId], references: [id])

  processId Int?
  process   Process? @relation("Process_processed4s", fields: [processId], references: [id])

  meta       Json?
  createdAt  DateTime  @default(now())
  receivedAt DateTime?

  @@index([toMmaCode, status, createdAt])
  @@index([fromMmaCode, status, createdAt])
  @@index([toMmaCode, supplierId, size, status])
  @@index([fromMmaCode, supplierId, size, status])
  @@index([transportId])
  @@index([processId])
  @@map("processed4s")
}

// -----------------------------------------------------
// 4-slot stage (Size required) — sorted4s
// -----------------------------------------------------
model sorted4s {
  id     Int        @id @default(autoincrement())
  bornAs BornAs
  status EdgeStatus

  fromMmaCode MmaCode?
  toMmaCode   MmaCode

  supplierId Int
  supplier   Supplier @relation(fields: [supplierId], references: [id])

  size Size

  dispatchShade  Shade
  receiveShade   Shade?
  dispatchAmount Int?
  receiveAmount  Int?

  dispatchQty Float
  receiveQty  Float?

  transportId Int?
  transport   Transport? @relation("Transport_sorted4s", fields: [transportId], references: [id])

  processId Int?
  process   Process? @relation("Process_sorted4s", fields: [processId], references: [id])

  meta       Json?
  createdAt  DateTime  @default(now())
  receivedAt DateTime?

  @@index([toMmaCode, status, createdAt])
  @@index([fromMmaCode, status, createdAt])
  @@index([toMmaCode, supplierId, size, status])
  @@index([fromMmaCode, supplierId, size, status])
  @@index([transportId])
  @@index([processId])
  @@map("sorted4s")
}

// -----------------------------------------------------
// 3-slot stage (no Size) — rawMaterial3s
// -----------------------------------------------------
model rawMaterial3s {
  id     Int        @id @default(autoincrement())
  bornAs BornAs
  status EdgeStatus

  fromMmaCode MmaCode?
  toMmaCode   MmaCode

  supplierId Int
  supplier   Supplier @relation(fields: [supplierId], references: [id])

  dispatchShade  Shade
  receiveShade   Shade?
  dispatchAmount Int?
  receiveAmount  Int?

  dispatchQty Float
  receiveQty  Float?

  transportId Int?
  transport   Transport? @relation("Transport_rawMaterial3s", fields: [transportId], references: [id])

  processId Int?
  process   Process? @relation("Process_rawMaterial3s", fields: [processId], references: [id])

  meta       Json?
  createdAt  DateTime  @default(now())
  receivedAt DateTime?

  @@index([toMmaCode, status, createdAt])
  @@index([fromMmaCode, status, createdAt])
  @@index([toMmaCode, supplierId, status])
  @@index([fromMmaCode, supplierId, status])
  @@index([transportId])
  @@index([processId])
  @@map("rawMaterial3s")
}
