// -----------------------------------------------------
// Prisma Schema — SQLite
// Three ledgers: mma2s, mma3s, mma4s
// -----------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// -------------------- Enums --------------------------

enum BornAs {
  DEPOSIT
  TRANSFER
}

enum EdgeStatus {
  IN_TRANSIT
  RECEIVED
  CANCELED
}

enum Size {
  LUMPS
  CHIPS
  FINE
}

// -------------------- Reference ----------------------

model Supplier {
  id   Int    @id @default(autoincrement())
  name String
  code String @unique
}

// -----------------------------------------------------
// 4-slot ledger (station implied by MMA code)
// Keys: Supplier · Shade · Size
// Table: mma4s
// -----------------------------------------------------
model MMA4S {
  id     Int        @id @default(autoincrement())
  bornAs BornAs
  status EdgeStatus

  fromMmaCode String? // NULL for deposits
  toMmaCode   String

  supplierId     Int
  size           Size // required in 4S
  amountDispatch Decimal @default(0)
  amountReceive  Decimal @default(0)

  dispatchShade String
  receiveShade  String? // set on receive (defaults to dispatchShade if not provided)

  dispatchQty Decimal
  receiveQty  Decimal?

  meta       Json?
  createdAt  DateTime  @default(now())
  receivedAt DateTime?

  @@index([toMmaCode, status, createdAt])
  @@index([fromMmaCode, status, createdAt])
  @@index([toMmaCode, supplierId, size, status])
  @@index([fromMmaCode, supplierId, size, status])
  @@map("mma4s")
}

// -----------------------------------------------------
// 3-slot ledger (station implied by MMA code)
// Keys: Supplier · Shade   (no Size)
// Table: mma3s
// -----------------------------------------------------
model MMA3S {
  id     Int        @id @default(autoincrement())
  bornAs BornAs
  status EdgeStatus

  fromMmaCode String?
  toMmaCode   String

  supplierId     Int // required in 3S
  amountDispatch Decimal @default(0)
  amountReceive  Decimal @default(0)

  dispatchShade String
  receiveShade  String?

  dispatchQty Decimal
  receiveQty  Decimal?

  meta       Json?
  createdAt  DateTime  @default(now())
  receivedAt DateTime?

  @@index([toMmaCode, status, createdAt])
  @@index([fromMmaCode, status, createdAt])
  @@index([toMmaCode, supplierId, status])
  @@index([fromMmaCode, supplierId, status])
  @@map("mma3s")
}

// -----------------------------------------------------
// 2-slot ledger (station implied by MMA code)
// Keys: Shade/Grade only (supplier optional; no Size)
// Table: mma2s
// -----------------------------------------------------
model MMA2S {
  id     Int        @id @default(autoincrement())
  bornAs BornAs
  status EdgeStatus

  fromMmaCode String?
  toMmaCode   String

  supplierId     Int? // optional in 2S; NOT part of slot identity
  amountDispatch Decimal @default(0)
  amountReceive  Decimal @default(0)

  dispatchShade String
  receiveShade  String?

  dispatchQty Decimal
  receiveQty  Decimal?

  meta       Json?
  createdAt  DateTime  @default(now())
  receivedAt DateTime?

  @@index([toMmaCode, status, createdAt])
  @@index([fromMmaCode, status, createdAt])
  @@index([toMmaCode, status])
  @@index([fromMmaCode, status])
  @@map("mma2s")
}
