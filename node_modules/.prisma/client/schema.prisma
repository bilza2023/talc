// schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum StationCode {
  BS1
  BS2
  BS3
  JSS
  ABS
  PSS
  KEF
  // add more when needed
}

enum TransportStatus {
  in_transit
  received
  cancelled
}

model Supplier {
  id   Int    @id @default(autoincrement())
  name String
  code String @unique // e.g. SUP001

  deposits   OreDeposit[] // ore received from outside
  transports OreTransport[] // ore moved between stations
}

// Minimal enums used by the two tables
enum OreEdgeEvent {
  dispatch // allocation out of a parent batch (in-transit)
  unload // receipt into a new child batch at destination
}

model oreBatch {
  id Int @id @default(autoincrement())

  // Where and what
  stationCode StationCode
  gradeCode   String

  // Authoritative quantities
  createdTon   Float // set once at birth (deposit OR unload)
  remainingTon Float // updated by events; source of truth

  // Birth info — exactly one of these identifies how this batch was born
  bornAs String // "deposit" or "unload" (keep as String to stay minimal)

  // Optional deposit metadata (since we dropped OreDeposit table)
  supplierId Int?

  depositedAt DateTime? // if bornAs = "deposit"

  // Timestamps (you can rely on remainingTon <= eps to infer closed)
  createdAt DateTime  @default(now())
  closedAt  DateTime?

  // Lineage (graph)
  edgesOut oreEdge[] @relation("EdgeParent") // this batch → others (dispatch)
  edgesIn  oreEdge[] @relation("EdgeChild") // others → this batch (unload)

  // Cross-material: ore → talc (process outputs from this ore batch)
  processOut processEdge[] @relation("ProcessParentOre")

  @@index([stationCode])
  @@index([bornAs])
}

model oreEdge {
  id        Int          @id @default(autoincrement())
  event     OreEdgeEvent // dispatch OR unload
  createdAt DateTime     @default(now())

  truckNo       String?
  amount        Int?
  // Graph endpoints (parent → child)
  parentBatchId Int // required for both events
  parentBatch   oreBatch @relation("EdgeParent", fields: [parentBatchId], references: [id])

  childBatchId Int? // only set for unload (destination batch)
  childBatch   oreBatch? @relation("EdgeChild", fields: [childBatchId], references: [id])

  // Event quantity (the delta)
  deltaTon Float // > 0

  @@index([event])
  @@index([parentBatchId])
  @@index([childBatchId])
}

///////////////////////////////
// Talc movement inside talc table (same-material, like oreEdge)
enum TalcEdgeEvent {
  dispatch // allocation out of a parent talc batch (in-transit)
  unload // receipt into a new child talc batch at destination
}

model talcBatch {
  id Int @id @default(autoincrement())

  // Where and what
  stationCode StationCode
  gradeCode   String

  // Authoritative quantities
  createdTon   Float // set once at birth (process OR unload)
  remainingTon Float // updated by events; source of truth

  // Birth info — exactly one of these identifies how this batch was born
  bornAs String // "process" or "unload" (kept as String to stay minimal)

  // Timestamps
  createdAt DateTime  @default(now())
  closedAt  DateTime?

  // Lineage (graph inside talc)
  edgesOut talcEdge[] @relation("TalcEdgeParent") // this batch → others (dispatch)
  edgesIn  talcEdge[] @relation("TalcEdgeChild") // others → this batch (unload)

  // Cross-material: ore → talc (process inputs into this talc batch)
  processIn processEdge[] @relation("ProcessChildTalc")

  @@index([stationCode])
  @@index([bornAs])
}

model talcEdge {
  id        Int           @id @default(autoincrement())
  event     TalcEdgeEvent // dispatch OR unload
  createdAt DateTime      @default(now())

  truckNo       String?
  amount        Int?
  // Graph endpoints (parent → child)
  parentBatchId Int // required for both events
  parentBatch   talcBatch @relation("TalcEdgeParent", fields: [parentBatchId], references: [id])

  childBatchId Int? // only set for unload (destination batch)
  childBatch   talcBatch? @relation("TalcEdgeChild", fields: [childBatchId], references: [id])

  // Event quantity (the delta)
  deltaTon Float // > 0

  @@index([event])
  @@index([parentBatchId])
  @@index([childBatchId])
}

// Cross-material linkage: ore → talc during processing ("talc-deposit")
model processEdge {
  id        Int      @id @default(autoincrement())
  processAt DateTime @default(now())

  // Endpoints across materials
  parentOreBatchId Int
  childTalcBatchId Int

  // Quantities
  oreDeltaTon  Float // ore consumed from the parent ore batch (> 0)
  talcDeltaTon Float? // optional: portion of talc produced into this child (helps recovery math)

  // Optional run correlation (group multiple inputs/outputs of one process run)
  runKey String?

  // Relations (named; back-relations live on oreBatch.processOut and talcBatch.processIn)
  parentOreBatch oreBatch  @relation("ProcessParentOre", fields: [parentOreBatchId], references: [id])
  childTalcBatch talcBatch @relation("ProcessChildTalc", fields: [childTalcBatchId], references: [id])

  @@index([parentOreBatchId])
  @@index([childTalcBatchId])
  @@index([runKey])
}

///////////////////////////////
model OreDeposit {
  id          Int         @id @default(autoincrement())
  stationCode StationCode
  supplierId  Int
  weightTon   Float
  gradeCode   String
  truckNo     String // new added
  depositedAt DateTime    @default(now())

  supplier Supplier @relation(fields: [supplierId], references: [id])

  @@index([stationCode, depositedAt])
}

model OreTransport {
  id          Int         @id @default(autoincrement())
  fromStation StationCode
  toStation   StationCode

  truckNo          String?
  sendWeightTon    Float
  receiveWeightTon Float?

  sendGradeCode    String
  receiveGradeCode String?

  status TransportStatus @default(in_transit)

  dispatchedAt DateTime  @default(now())
  receivedAt   DateTime?
  receivedBy   String?

  supplierId   Int?
  supplier     Supplier?     @relation(fields: [supplierId], references: [id])
  talcDeposits talcDeposit[]

  @@index([fromStation, dispatchedAt])
  @@index([toStation, receivedAt])
}

model talcDeposit {
  id          Int         @id @default(autoincrement())
  stationCode StationCode
  weightTon   Float
  gradeCode   String
  depositedAt DateTime    @default(now())

  // NEW: traceability link (nullable so external talc is still allowed)
  oreTransportId Int?
  oreTransport   OreTransport? @relation(fields: [oreTransportId], references: [id])

  @@index([stationCode, depositedAt])
  @@index([oreTransportId])
}

model talcTransport {
  id          Int         @id @default(autoincrement())
  fromStation StationCode
  toStation   StationCode

  truckNo          String?
  sendWeightTon    Float
  receiveWeightTon Float?

  sendGradeCode    String
  receiveGradeCode String?

  status TransportStatus @default(in_transit)

  dispatchedAt DateTime  @default(now())
  receivedAt   DateTime?
  receivedBy   String?

  supplierId Int?

  @@index([fromStation, dispatchedAt])
  @@index([toStation, receivedAt])
}

model Log {
  id        Int      @id @default(autoincrement())
  level     String   @default("info") // "info" | "warn" | "error"
  type      String? // e.g. "ORE_DEPOSIT", "ORE_DISPATCH"
  metadata  Json? // arbitrary payload
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("logs")
}
